<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Material.App" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary</item>
        <item name="colorOnPrimary">@color/off_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/very_dark_blue</item>
        <item name="colorSecondaryVariant">@color/green_tertiary</item>
        <item name="colorOnSecondary">@color/green_secondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>