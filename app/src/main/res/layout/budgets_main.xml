<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CFC7C7">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_700"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_baseline_menu_24"
        app:title="Budgets"
        app:titleTextColor="#FFFFFF" />

    <RelativeLayout
        android:id="@+id/relativeLayout_BudgetsDate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar10">


        <TextView
            android:id="@+id/textView65"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="728dp"
            android:text="July 16, 2022"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="413dp"
        android:layout_height="720dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayout_Budgets"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_Budgets1"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_margin="10dp"
                android:background="@color/white"
                app:cardCornerRadius="15dp"
                app:layout_column="0"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="10dp">

                <RelativeLayout
                    android:id="@+id/relativeLayout_Budgets1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView12"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/ic_beauty" />

                    <TextView
                        android:id="@+id/textView66"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_toRightOf="@id/imageView12"
                        android:text="Mac's New Collection"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView67"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView66"
                        android:layout_marginStart="16dp"
                        android:layout_toRightOf="@id/imageView12"
                        android:text="Beauty" />

                    <ImageButton
                        android:id="@+id/imageButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/material_on_background_disabled"
                        app:srcCompat="@drawable/ic_baseline_arrow_forward_ios_25" />

                    <LinearLayout
                        android:id="@+id/linearLayout_Budgets1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView67"
                        android:background="@drawable/linestroke_gray">

                        <TextView
                            android:id="@+id/textView68"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView69"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets1"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="Spent" />

                    <TextView
                        android:id="@+id/textView70"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets1"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="16dp"
                        android:text="Left to Spend" />

                    <TextView
                        android:id="@+id/textView71"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets1"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Limit" />

                    <TextView
                        android:id="@+id/textView72"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView69"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:text="₱1,500"
                        android:textColor="#03CCD9"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView73"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView70"
                        android:layout_centerInParent="true"
                        android:text="₱1,000"
                        android:textColor="#03CCD9"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView74"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView71"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="16dp"
                        android:text="₱2,500"
                        android:textColor="#03CCD9"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView72"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:progressDrawable="@drawable/custom_progress_bluebg" />

                    <ImageView
                        android:id="@+id/imageView14"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_below="@id/progressBar1"
                        android:layout_marginLeft="20dp"
                        app:srcCompat="@drawable/ic_sharp_local_fire_department" />

                    <TextView
                        android:id="@+id/textView80"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressBar1"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_toRightOf="@id/imageView14"
                        android:text="Your limit for Mac’s New Collection is on track"
                        android:textSize="12sp" />
                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView75"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="July 3, 2022"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_column="0"
                app:layout_row="1" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_Budgets2"
                android:layout_width="match_parent"
                android:layout_height="202dp"
                android:layout_margin="10dp"
                android:background="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:layout_column="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_row="2"
                tools:layout_editor_absoluteX="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imageView13"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/ic_medicine" />

                    <TextView
                        android:id="@+id/textView76"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_toRightOf="@id/imageView13"
                        android:text="Medicine"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView77"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView76"
                        android:layout_marginStart="16dp"
                        android:layout_toRightOf="@id/imageView13"
                        android:text="Health" />

                    <ImageButton
                        android:id="@+id/imageButton2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/material_on_background_disabled"
                        app:srcCompat="@drawable/ic_baseline_arrow_forward_ios_25" />

                    <LinearLayout
                        android:id="@+id/linearLayout_Budgets2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView77"
                        android:background="@drawable/linestroke_gray"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView78"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView79"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets2"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="Spent" />

                    <TextView
                        android:id="@+id/textView81"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets2"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="16dp"
                        android:text="Left to Spend" />

                    <TextView
                        android:id="@+id/textView82"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets2"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Limit" />

                    <TextView
                        android:id="@+id/textView83"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView79"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:text="₱900"
                        android:textColor="#9804DE"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView84"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView81"
                        android:layout_centerInParent="true"
                        android:text="₱100"
                        android:textColor="#9804DE"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView86"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView82"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="16dp"
                        android:text="₱1,000"
                        android:textColor="#9804DE"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView83"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:progressDrawable="@drawable/custom_progress_purplebg" />

                    <ImageView
                        android:id="@+id/imageView15"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_below="@id/progressBar2"
                        android:layout_marginLeft="20dp"
                        app:srcCompat="@drawable/ic_surprise" />

                    <TextView
                        android:id="@+id/textView87"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressBar2"
                        android:layout_marginStart="16dp"
                        android:layout_toRightOf="@id/imageView15"
                        android:text="Whoops! You almost touch your budget"
                        android:textSize="12sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_Budgets3"
                android:layout_width="match_parent"
                android:layout_height="203dp"
                android:layout_margin="10dp"
                android:background="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:layout_column="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_row="3"
                tools:layout_editor_absoluteX="10dp" >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView16"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="10dp"
                        app:srcCompat="@drawable/ic_dental" />

                    <TextView
                        android:id="@+id/textView88"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_toRightOf="@id/imageView16"
                        android:text="Dentist Appointment"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView89"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView88"
                        android:layout_marginStart="16dp"
                        android:layout_toRightOf="@id/imageView16"
                        android:text="Health" />

                    <ImageButton
                        android:id="@+id/imageButton3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/material_on_background_disabled"
                        app:srcCompat="@drawable/ic_baseline_arrow_forward_ios_25" />

                    <LinearLayout
                        android:id="@+id/linearLayout_Budgets3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView89"
                        android:background="@drawable/linestroke_gray"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView90"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView91"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets3"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="Spent" />

                    <TextView
                        android:id="@+id/textView92"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets3"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="16dp"
                        android:text="Left to Spend" />

                    <TextView
                        android:id="@+id/textView93"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/linearLayout_Budgets3"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Limit" />

                    <TextView
                        android:id="@+id/textView94"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView91"
                        android:layout_alignParentLeft="true"
                        android:layout_marginStart="16dp"
                        android:text="₱500"
                        android:textColor="#EB8FA6"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView95"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView92"
                        android:layout_centerInParent="true"
                        android:text="₱300"
                        android:textColor="#EB8FA6"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView96"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView93"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="16dp"
                        android:text="₱800"
                        android:textColor="#EB8FA6"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar3"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView94"
                        android:layout_centerInParent="true"
                        android:layout_margin="16dp"
                        android:progressDrawable="@drawable/custom_progress_pinkbg" />

                    <ImageView
                        android:id="@+id/imageView17"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_below="@id/progressBar3"
                        android:layout_marginLeft="20dp"
                        app:srcCompat="@drawable/ic_baseline_warning_24" />

                    <TextView
                        android:id="@+id/textView97"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/progressBar3"
                        android:layout_marginStart="16dp"
                        android:layout_toRightOf="@id/imageView17"
                        android:text="Oh no! You overspend your budget"
                        android:textSize="12sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="16dp"
                android:background="@color/material_on_background_disabled"
                android:clickable="true"
                app:backgroundTint="#007FFF"
                app:layout_column="0"
                app:layout_gravity="bottom|end"
                app:layout_row="3"
                app:srcCompat="@drawable/ic_add" />

        </androidx.gridlayout.widget.GridLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>