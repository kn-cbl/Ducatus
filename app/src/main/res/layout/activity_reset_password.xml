<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eff1f6"
    tools:context=".ResetPassword">

<!--    <ImageButton-->
<!--        android:id="@+id/imgBtnResetPasswordBack"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginTop="40dp"-->
<!--        android:layout_marginStart="20dp"-->
<!--        android:background="?attr/selectableItemBackgroundBorderless"-->
<!--        android:scaleX="1.3"-->
<!--        android:scaleY="1.3"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:srcCompat="@drawable/ic_baseline_arrow_back_24" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginLeft="33dp"
        android:layout_marginRight="33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Create New\nPassword"
            android:textColor="#000000"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/textView25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/inter_regular"
            android:text="Set a new password for your account"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbResetPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateDrawable="@drawable/progress_bg"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvResetPasswordError"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="-45dp"
            android:gravity="center"
            android:fontFamily="@font/inter_regular"
            android:visibility="visible"
            android:text=""
            android:textColor="#FF0000"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            app:hintEnabled="false"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#878787">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetPasswordNew"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/signin_input"
                android:textColor="#000000"
                android:textColorHint="#878787"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:inputType="textPassword"
                android:hint="New Password"
                android:ems="10"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvResetPasswordNewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text=""
            android:textColor="#FF0000"
            android:textSize="12sp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:hintEnabled="false"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#878787">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetPasswordConfirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/signin_input"
                android:textColor="#000000"
                android:textColorHint="#878787"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:inputType="textPassword"
                android:hint="Confirm New Password"
                android:ems="10"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvResetPasswordConfirmError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text=""
            android:textColor="#FF0000"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/green_button"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="0.04"
            android:text="Reset Password"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>