<?xml version="1.0" encoding="utf-8"?>


    <FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CFC7C7"
            tools:layout_editor_absoluteX="32dp"
            tools:layout_editor_absoluteY="105dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_Netflix"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_margin="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:layout_column="0"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="10dp">

                <RelativeLayout
                    android:id="@+id/relativeLayout_Netflix"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="35dp"
                        app:srcCompat="@drawable/ic_netflix" />

                    <TextView
                        android:id="@+id/textView38"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="30dp"
                        android:text="Netflix"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView39"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="47dp"
                        android:text="TV, Streaming"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textView40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="65dp"
                        android:text="Every 1 month"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="350dp"
                        android:layout_marginTop="25dp"
                        app:srcCompat="@drawable/ic_recurring" />

                    <TextView
                        android:id="@+id/textView41"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="320dp"
                        android:layout_marginTop="47dp"
                        android:text="₱500.00"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView42"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="310dp"
                        android:layout_marginTop="65dp"
                        android:text="Due: Mar 15"
                        android:textSize="12sp" />
                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView45"
                android:layout_width="389dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="OVERDUE"
                android:textColor="#000000"
                android:textStyle="bold"
                app:layout_column="0"
                app:layout_row="1" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_Maynilad"
                android:layout_width="match_parent"
                android:layout_height="148dp"
                android:layout_margin="10dp"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:layout_column="0"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="940dp">

                    <ImageView
                        android:id="@+id/imageView10"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="32dp"
                        app:srcCompat="@drawable/ic_maynilad" />

                    <TextView
                        android:id="@+id/textView46"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="28dp"
                        android:text="Maynilad"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView47"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="45dp"
                        android:text="Water"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textView48"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="63dp"
                        android:text="Every 1 month"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/imageView11"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="350dp"
                        android:layout_marginTop="25dp"
                        app:srcCompat="@drawable/ic_baseline_warning_24" />

                    <TextView
                        android:id="@+id/textView49"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="320dp"
                        android:layout_marginTop="47dp"
                        android:text="₱500.00"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="87dp"
                        android:text="May 15"
                        android:textColor="#FF0000"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textView51"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="105dp"
                        android:text="2 days overdue"
                        android:textColor="#FF0000"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textView52"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="338dp"
                        android:layout_marginTop="87dp"
                        android:text="May 15"
                        android:textColor="#007FFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textView53"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="295dp"
                        android:layout_marginTop="105dp"
                        android:text="Due on 25 days"
                        android:textColor="#007FFF"
                        android:textSize="12sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </androidx.gridlayout.widget.GridLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#007FFF"
        android:clickable="true"
        app:srcCompat="@drawable/ic_add" />
</FrameLayout>
