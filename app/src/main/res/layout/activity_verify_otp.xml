<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerifyOTP">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/otp_email"
        android:scaleType="fitXY"  />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="117dp" >

        <ImageButton
            android:id="@+id/imgBtnVerifyOTPBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_marginStart="36dp"
            android:scaleX="1.3"
            android:scaleY="1.3"
            android:background="@drawable/oval"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24"
            android:padding="6dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="320dp"
            android:layout_height="480dp"
            android:layout_marginStart="45dp"
            android:layout_marginEnd="45dp"
            android:layout_marginTop="50dp"
            app:cardBackgroundColor="#F8F8F8"
            app:cardCornerRadius="25dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="40dp"
                    app:srcCompat="@drawable/user_one"
                    android:layout_gravity="end"/>

                <TextView
                    android:id="@+id/textView28"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Verification Code"
                    android:textAlignment="center"
                    android:textColor="#545454"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/textView29"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="OTP has been sent to"
                    android:textAlignment="center"
                    android:textColor="#545454"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textView30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="user@email.com"
                    android:textAlignment="center"
                    android:textColor="#0FA958"
                    android:textSize="14sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginLeft="35dp"
                    android:layout_marginRight="35dp"
                    android:layout_marginTop="36dp">

                    <EditText
                        android:id="@+id/editTextTextPersonName4"
                        android:layout_width="183dp"
                        android:layout_height="51dp"
                        android:layout_weight="1"
                        android:background="@drawable/otp_input"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="25sp"
                        android:textColor="#000000"
                        android:padding="10dp"
                        android:textAlignment="center" />

                    <EditText
                        android:id="@+id/editTextTextPersonName5"
                        android:layout_width="183dp"
                        android:layout_height="51dp"
                        android:layout_weight="1"
                        android:background="@drawable/otp_input"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="25sp"
                        android:textColor="#000000"
                        android:padding="10dp"
                        android:textAlignment="center"/>

                    <EditText
                        android:id="@+id/editTextTextPersonName6"
                        android:layout_width="183dp"
                        android:layout_height="51dp"
                        android:layout_weight="1"
                        android:background="@drawable/otp_input"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="25sp"
                        android:textColor="#000000"
                        android:padding="10dp"
                        android:textAlignment="center"/>

                    <EditText
                        android:id="@+id/editTextTextPersonName7"
                        android:layout_width="183dp"
                        android:layout_height="51dp"
                        android:layout_weight="1"
                        android:background="@drawable/otp_input"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="25sp"
                        android:textColor="#000000"
                        android:padding="10dp"
                        android:textAlignment="center"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:visibility="invisible"
                    android:text="Incorrect code, please try again"
                    android:textAlignment="center"
                    android:textColor="#FF0000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnVerifyOTP"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="35dp"
                    android:background="@drawable/green_button"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.04"
                    android:text="Verify"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textView32"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Resend Verification Code"
                    android:textAlignment="center"
                    android:textColor="#545454"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>