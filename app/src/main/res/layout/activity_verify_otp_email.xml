<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerifyOTPEmailActivity">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/icon_hint"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/otp_email" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="117dp">

        <ImageButton
            android:id="@+id/imgBtnVerifyOTPEmailBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/oval"
            android:contentDescription="@string/go_back"
            android:padding="6dp"
            android:scaleX="1.3"
            android:scaleY="1.3"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

        <androidx.cardview.widget.CardView
            android:layout_width="320dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            app:cardBackgroundColor="@color/cardview_bg"
            app:cardCornerRadius="25dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="40dp"
                    android:contentDescription="@string/user_profile"
                    app:srcCompat="@drawable/user_one"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:id="@+id/textView28"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/verification_code"
                    android:textAlignment="center"
                    android:textColor="@color/gray_text"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/textView29"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/otp_sent"
                    android:textAlignment="center"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvVerifyOTPUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/email"
                    android:textAlignment="center"
                    android:textColor="@color/green_secondary"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbVerifyOTPEmail"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="-40dp"
                    android:indeterminateDrawable="@drawable/progress_bg"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tvVerifyOTPEmailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_regular"
                    android:text=""
                    android:textAlignment="center"
                    android:textColor="@color/red_text_2"
                    android:textSize="12sp"
                    android:visibility="visible" />

                <EditText
                    android:id="@+id/etOTPEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="35dp"
                    android:autofillHints=""
                    android:fontFamily="@font/inter_regular"
                    android:inputType="number"
                    android:maxLength="6"
                    android:padding="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    tools:ignore="LabelFor,TextFields" />

                <Button
                    android:id="@+id/btnVerifyOTPEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="35dp"
                    android:background="@drawable/green_button"
                    android:backgroundTint="@color/green_primary"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.04"
                    android:text="@string/verify"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvResendOTPEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:enabled="false"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/resend_in_60"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>