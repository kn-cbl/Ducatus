<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imageView20"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/user_profile" />

            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="54dp"
                android:background="@drawable/oval"
                android:padding="6dp"
                android:scaleX="1.3"
                android:scaleY="1.3"
                app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

            <ImageView
                android:id="@+id/imageView23"
                android:layout_width="match_parent"
                android:layout_height="289dp"
                android:layout_below="@+id/imageView20"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="-60dp"
                android:layout_marginBottom="-1dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/user_profile_bg" />

            <TextView
                android:id="@+id/textView79"
                android:layout_width="306dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imageView23"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="54dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="51dp"
                android:fontFamily="@font/blinker_semibold"
                android:text="John Doe"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textView80"
                android:layout_width="213dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView79"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="99dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="99dp"
                android:fontFamily="@font/blinker_regular"
                android:text="joined on March 13, 2020"
                android:textAlignment="center"
                android:textColor="#545454"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextInputLayout4"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView80"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="35dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="35dp"
                android:hint="Email Address"
                app:boxCornerRadiusBottomEnd="5dp"
                app:boxCornerRadiusBottomStart="5dp"
                app:boxCornerRadiusTopEnd="5dp"
                app:boxCornerRadiusTopStart="5dp"
                app:boxStrokeColor="@color/mtrl_textinput_default_box_stroke_color"
                app:hintTextColor="@color/teal_200"
                android:textColorHint="@color/teal_200">

                <!--this is the actual edit text which takes the input-->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TextInputEditText4"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="textEmailAddress"
                    android:paddingBottom="15dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextInputLayout5"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/TextInputLayout4"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="35dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="35dp"
                android:hint="Mobile Number"
                app:boxCornerRadiusBottomEnd="5dp"
                app:boxCornerRadiusBottomStart="5dp"
                app:boxCornerRadiusTopEnd="5dp"
                app:boxCornerRadiusTopStart="5dp"
                app:boxStrokeColor="@color/mtrl_textinput_default_box_stroke_color"
                app:hintTextColor="@color/teal_200"
                android:textColorHint="@color/teal_200">

                <!--this is the actual edit text which takes the input-->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/TextInputEditText5"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:inputType="textPersonName"
                    android:paddingBottom="15dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/button10"
                android:layout_width="334dp"
                android:layout_height="50dp"
                android:layout_below="@+id/TextInputLayout5"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="36dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="41dp"
                android:background="@drawable/green_button"
                android:text="Edit Profile"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

        </RelativeLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>