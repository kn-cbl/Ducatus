<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvItemSubscription"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/off_white"
    app:cardCornerRadius="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <FrameLayout
            android:id="@+id/flItemSubscriptionIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/lighter_gray">

            <ImageView
                android:id="@+id/ivItemSubscriptionIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/category_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/flItemSubscriptionIcon"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemSubscriptionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical"
                    android:maxLines="2"
                    android:text="@string/subscription_name"
                    android:textColor="@color/off_black" />

                <TextView
                    android:id="@+id/tvItemSubscriptionCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center_vertical"
                    android:maxLines="2"
                    android:text="@string/category_name"
                    android:textColor="@color/slightly_darker_gray" />

                <TextView
                    android:id="@+id/tvItemSubscriptionFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="@string/frequency"
                    android:textColor="@color/slightly_darker_gray" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llEndInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="end"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivItemSubscriptionTypeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/icon"
                    app:srcCompat="@drawable/ic_local_due_date_24_bright_blue" />

                <TextView
                    android:id="@+id/tvItemSubscriptionAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_semi_bold"
                    android:gravity="center_vertical|end"
                    android:maxLines="1"
                    android:text="@string/amount"
                    android:textColor="@color/off_black" />

                <TextView
                    android:id="@+id/tvItemSubscriptionDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center_vertical|end"
                    android:maxLines="1"
                    android:text="@string/date"
                    android:textColor="@color/darker_gray" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>