<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darker_white_2"
    android:clipToPadding="false"
    android:paddingBottom="80dp"
    tools:context=".TipsVideosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTipsVideosSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/sort_by"
            android:textColor="@color/off_black"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_baseline_sort_24"
            app:drawableTint="@color/off_black" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTipsVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>