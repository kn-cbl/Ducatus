<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F8F8"
        tools:layout_editor_absoluteX="18dp"
        tools:layout_editor_absoluteY="48dp">

        <RelativeLayout
            android:id="@+id/rlUserProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView11"
                android:layout_width="33dp"
                android:layout_height="46dp"
                app:srcCompat="@drawable/user_settings"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView34"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/imageView11"
                android:fontFamily="@font/inter_medium"
                android:text="@string/user_profile"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView35"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView11"
                android:fontFamily="@font/inter_medium"
                android:text="@string/user_profile_description"
                android:textColor="#808080"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/imageView12"
                android:layout_width="33dp"
                android:layout_height="46dp"
                app:srcCompat="@drawable/lock"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView36"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/imageView12"
                android:fontFamily="@font/inter_medium"
                android:text="@string/password"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView39"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView12"
                android:fontFamily="@font/inter_medium"
                android:text="@string/update_password"
                android:textColor="#808080"
                android:textSize="12sp" />

        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/textView40"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_settings"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:textColor="#545454"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp">

            <ImageView
                android:id="@+id/imageView13"
                android:layout_width="33dp"
                android:layout_height="46dp"
                app:srcCompat="@drawable/accounts"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView41"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="-5dp"
                android:layout_toEndOf="@+id/imageView13"
                android:fontFamily="@font/inter_medium"
                android:text="@string/accounts"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView13"
                android:fontFamily="@font/inter_medium"
                android:text="@string/accounts_description"
                android:textSize="12sp"
                android:textColor="#808080"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp">

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="33dp"
                android:layout_height="46dp"
                app:srcCompat="@drawable/category"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView44"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="-5dp"
                android:layout_toEndOf="@+id/imageView14"
                android:fontFamily="@font/inter_medium"
                android:text="@string/categories"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView45"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView14"
                android:fontFamily="@font/inter_medium"
                android:text="@string/categories_description"
                android:textSize="12sp"
                android:textColor="#808080"/>

        </RelativeLayout>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/textView47"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/other_settings"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:textSize="14sp"
            android:textColor="#545454"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp">

            <ImageView
                android:id="@+id/imageView15"
                android:layout_width="33dp"
                android:layout_height="46dp"
                app:srcCompat="@drawable/notif"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView48"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/imageView15"
                android:fontFamily="@font/inter_medium"
                android:text="@string/notifications"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView49"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView15"
                android:fontFamily="@font/inter_medium"
                android:text="@string/notifications_description"
                android:textSize="12sp"
                android:textColor="#808080"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp">

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="33dp"
                android:layout_height="46dp"
                android:layout_marginTop="-5dp"
                app:srcCompat="@drawable/privacy"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView51"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="-5dp"
                android:layout_toEndOf="@+id/imageView16"
                android:fontFamily="@font/inter_medium"
                android:text="@string/privacy"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView52"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView16"
                android:fontFamily="@font/inter_medium"
                android:text="@string/privacy_description"
                android:textSize="12sp"
                android:textColor="#808080"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlAboutApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/imageView17"
                android:layout_width="33dp"
                android:layout_height="46dp"
                android:layout_marginTop="-5dp"
                app:srcCompat="@drawable/about"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView55"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/imageView17"
                android:fontFamily="@font/inter_medium"
                android:text="@string/about_app"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView56"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView17"
                android:fontFamily="@font/inter_medium"
                android:text="@string/about_app_description"
                android:textColor="#808080"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/imageView18"
                android:layout_width="33dp"
                android:layout_height="46dp"
                android:layout_marginTop="0dp"
                app:srcCompat="@drawable/logout"
                android:contentDescription="@string/icon_hint" />

            <TextView
                android:id="@+id/textView57"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="9dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@+id/imageView18"
                android:fontFamily="@font/inter_medium"
                android:text="@string/logout"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView58"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="22dp"
                android:layout_toEndOf="@+id/imageView18"
                android:fontFamily="@font/inter_medium"
                android:text="@string/logout_description"
                android:textColor="#808080"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

</FrameLayout>