<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AboutDucatus">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_white"
            app:title="About Ducatus"
            app:titleTextColor="@color/white"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView19"
                android:layout_width="145dp"
                android:layout_height="166dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                app:srcCompat="@drawable/ducatus" />

            <TextView
                android:id="@+id/textView75"
                android:layout_width="212dp"
                android:layout_height="64dp"
                android:layout_below="@+id/textView74"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="32dp"
                android:layout_toEndOf="@+id/imageView19"
                android:fontFamily="@font/inter_regular"
                android:justificationMode="inter_word"
                android:text="A Budgeting and Financing Android Mobile Application with Subscription Management and Loan Monitoring"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView74"
                android:layout_width="128dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="52dp"
                android:layout_marginEnd="92dp"
                android:layout_toEndOf="@+id/imageView19"
                android:fontFamily="@font/inter_semibold"
                android:text="Ducatus"
                android:textColor="#000000"
                android:textSize="18sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/textView76"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Budget and Finance Manager"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/textView77"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="It is a mobile application that allows users to set their monthly expenses and their amount, assisting them in their financial transactions to reduce their unnecessary expenses, and set a given budget for a given time."
            android:fontFamily="@font/inter_regular"
            android:justificationMode="inter_word"
            android:textColor="#000000"
            android:textSize="13sp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginTop="5dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>