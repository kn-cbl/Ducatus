<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B2B2B"
    android:backgroundTint="#FFFFFF"
    android:backgroundTintMode="screen"
    tools:context=".EditGoal">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/editGoal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_primary"
        android:clickable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/editgoal_menu"
        app:navigationIcon="@drawable/ic_close"
        app:title="Edit Goal"
        app:titleTextColor="@color/white">
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/linearLayout1_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/text_input"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/editGoal_toolbar"
        tools:layout_editor_absoluteX="10dp">

        <TextView
            android:id="@+id/Name_editGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Name"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextName_editGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="Add Name"
            android:inputType="textPersonName"
            android:paddingStart="8dp"
            android:textColorHint="#7A7A7A"
            android:textSize="16sp"
            tools:text="@tools:sample/full_names" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/linearLayout1_editGoal"
        tools:layout_editor_absoluteX="10dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/text_input">

            <TextView
                android:id="@+id/Color_editGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Color"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_color"
                android:layout_width="242dp"
                android:layout_height="15dp"
                android:layout_below="@id/Color_editGoal"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:dropDownWidth="wrap_content"
                android:spinnerMode="dropdown"
                android:textAlignment="center" />

        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/relativeLayout3"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/text_input"
            android:visibility="visible">

            <TextView
                android:id="@+id/Icon_editGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Icon"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/spinner_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:srcCompat="@drawable/ic_car"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/Icon_editGoal"
                app:layout_constraintTop_toBottomOf="@+id/Icon_editGoal"
                app:layout_constraintVertical_bias="1.0" />

            <ImageView
                android:id="@+id/icon_dropdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="TODO"
                app:srcCompat="@drawable/ic_dropdown"
                app:layout_constraintBottom_toBottomOf="@+id/spinner_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@id/spinner_icon"
                app:layout_constraintTop_toBottomOf="@id/Icon_editGoal" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/text_input"
        android:layout_margin="10dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayout2_editGoal">

        <TextView
            android:id="@+id/targetAmount_editGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Target Amount"
            android:textColor="@color/black"
            android:textStyle="bold"
            />

        <EditText
            android:id="@+id/edittargetAmount_editGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="200,000.00"
            android:textSize="16sp"
            android:textColorHint="#7A7A7A"
            android:inputType="number"
            android:paddingStart="8dp"
            android:drawableEnd="@drawable/ic_dropdown"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/text_input"
        android:layout_margin="10dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayout3_editGoal">

        <TextView
            android:id="@+id/savedAlready_editGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Saved Already"
            android:textColor="@color/black"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/textSavedAlready_editGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="150,000.00"
            android:textSize="16sp"
            android:textColorHint="#7A7A7A"
            android:inputType="number"
            android:paddingStart="8dp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout5_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/text_input"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4_editGoal">

        <TextView
            android:id="@+id/textDesiredDate_editGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Desired Date"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDate_editGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="MM/DD/YYYY"
            android:inputType="date"
            android:paddingStart="8dp"
            android:textColorHint="#7A7A7A"
            android:textSize="16sp"
            tools:text="@tools:sample/date/mmddyy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout6_editGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/text_input"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5_editGoal">

        <TextView
            android:id="@+id/editNotes_editGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="Notes"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextNotes_editGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="Add Notes"
            android:inputType="textImeMultiLine"
            android:paddingStart="8dp"
            android:textColorHint="#7A7A7A"
            android:textSize="16sp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>