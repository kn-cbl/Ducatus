<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_700"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/check_menu"
        app:navigationIcon="@drawable/ic_baseline_clear_24"
        app:title="Add New Record"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:id="@+id/linearLayout_AddNewRecordBtn"
        android:layout_width="382dp"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar24">

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/incomeBtn2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:button="@android:color/transparent"
                android:checked="true"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onRadioButtonClicked"
                android:text="INCOME"
                android:textColor="#545454"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/expensesBtn2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:button="@android:color/transparent"
                android:checked="true"
                android:clickable="true"
                android:gravity="center"
                android:onClick="onRadioButtonClicked"
                android:text="EXPENSES"
                android:textColor="#545454"
                android:textStyle="bold" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_AddNewRecordLine"
        android:layout_width="382dp"
        android:layout_height="23dp"
        android:layout_below="@id/linearLayout_AddNewRecordBtn"
        android:background="@drawable/linestroke_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_AddNewRecordBtn">

        <TextView
            android:id="@+id/textView258"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_TopUpValue"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="150dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_AddNewRecordLine">

        <TextView
            android:id="@+id/textView263"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Top up value (₱)"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/relativeLayout_TopUpValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_AddNewRecordLine">

        <TextView
            android:id="@+id/value1"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="100"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value2"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_marginStart="10dp"
            android:layout_toRightOf="@+id/value1"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="300"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value3"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_marginStart="10dp"
            android:layout_toRightOf="@+id/value2"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="500"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value4"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value1"
            android:layout_marginTop="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="1,000"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value5"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value2"
            android:layout_toRightOf="@id/value4"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="1,500"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value6"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value3"
            android:layout_toRightOf="@id/value5"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="2,000"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value7"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value4"
            android:layout_marginTop="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="3,000"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value8"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value5"
            android:layout_toRightOf="@id/value7"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="4,000"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/value9"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_below="@id/value6"
            android:layout_toRightOf="@id/value8"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/square_shape_lightgreen"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="5,000"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearLayout_BelowTopUpValue"
        android:layout_width="382dp"
        android:layout_height="23dp"
        android:layout_below="@id/relativeLayout_TopUpValue"
        android:background="@drawable/linestroke_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout_TopUpValue">

        <TextView
            android:id="@+id/textView269"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_InputAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_BelowTopUpValue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/addloan_input"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/textView270"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Input Amount (₱)"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTextTextPersonName6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:ems="10"
                android:hint="Name"
                android:inputType="textPersonName"
                android:paddingStart="8dp"
                android:textColorHint="#7A7A7A"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_AddNewRecordCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_InputAmount">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/addloan_input"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/textView272"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Category"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/autoCompleteTextView29"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                android:ems="10"
                android:hint="Select Category"
                android:inputType="textPersonName"
                android:paddingStart="8dp"
                android:text="Cash"
                android:textColorHint="#7A7A7A"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout_AddNewRecordCategory">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/addloan_input"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/textView273"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="Notes"
                android:textColor="@color/black"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/editTextTextMultiLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:ems="10"
                android:hint="Add Notes"
                android:inputType="textPersonName"
                android:paddingStart="8dp"
                android:textColorHint="#7A7A7A"
                android:textSize="16sp" />


        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#007FFF"
        android:clickable="true"
        app:srcCompat="@drawable/ic_scan"
        android:tint="@color/white"
        android:visibility="visible"
        app:fabCustomSize="60dp"
        app:layout_anchorGravity="bottom|end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>