<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResetPasswordMobileNumber">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/reset_password_email"
        android:scaleType="fitXY" />

    <ProgressBar
        android:id="@+id/pbResetPasswordMobileNumber"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="215dp"
        android:indeterminateDrawable="@drawable/progress_bg"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="97dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp">

        <ImageButton
            android:id="@+id/imgBtnResetPasswordMobileNumberBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:scaleX="1.3"
            android:scaleY="1.3"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:letterSpacing="0.02"
            android:fontFamily="@font/inter_semibold"
            android:text="Reset"
            android:textColor="#000000"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/textView24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:letterSpacing="0.02"
            android:fontFamily="@font/inter_semibold"
            android:text="Password"
            android:textColor="#000000"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/textView25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:text="Enter your mobile number to request for a password reset"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etResetPasswordMobileNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/signin_input"
            android:ems="10"
            android:fontFamily="@font/inter_medium"
            android:hint="Mobile Number"
            android:inputType="text"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:textColor="#000000"
            android:textColorHint="#878787"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvResetPasswordMobileNumberError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:visibility="invisible"
            android:text="Please enter mobile number"
            android:textColor="#FF0000"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnResetPasswordMobileNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/green_button"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="0.04"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvResetPasswordEmailLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Try another way?"
            android:textColor="#545454"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>