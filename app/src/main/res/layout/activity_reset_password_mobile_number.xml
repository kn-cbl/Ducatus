<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eff1f6"
    tools:context=".ResetPasswordMobileNumber">

    <ImageButton
        android:id="@+id/imgBtnResetPasswordMobileNumberBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleX="1.3"
        android:scaleY="1.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="97dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Reset\nPassword"
            android:textColor="#000000"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/textView25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/inter_regular"
            android:text="Enter your mobile number to request for a password reset"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbResetPasswordMobileNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateDrawable="@drawable/progress_bg"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvResetPasswordMobileErrorAuth"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="-40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/inter_regular"
            android:text=""
            android:textColor="#ff0000"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal" >

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_phone_number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="+63"
                android:inputType="none"
                android:enabled="false"
                android:fontFamily="@font/inter_medium"
                android:textColor="#505050"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/etResetPasswordMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_phone_number_2"
                android:ems="10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:hint="••••••••••"
                android:inputType="number"
                android:maxLength="10"
                android:fontFamily="@font/inter_medium"
                android:textColor="#505050"
                android:textColorHint="#878787"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvResetPasswordMobileNumberError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:visibility="invisible"
            android:text="Please enter mobile number"
            android:textColor="#FF0000"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnResetPasswordMobileNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/green_button"
            android:fontFamily="@font/inter_bold"
            android:letterSpacing="0.04"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResetPasswordEmailLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="Try another way?"
            android:textColor="#545454"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>