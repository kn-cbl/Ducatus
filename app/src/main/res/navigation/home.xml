<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ducatus.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings"/>
    <fragment
        android:id="@+id/budgetsFragment"
        android:name="com.ducatus.BudgetsFragment"
        android:label="fragment_budgets"
        tools:layout="@layout/fragment_budgets" />
    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.ducatus.TransactionsFragment"
        android:label="fragment_transactions"
        tools:layout="@layout/fragment_transactions" />
    <fragment
        android:id="@+id/loansFragment"
        android:name="com.ducatus.LoansFragment"
        android:label="fragment_loans"
        tools:layout="@layout/fragment_loans" />
    <fragment
        android:id="@+id/subscriptionsViewPagerFragment"
        android:name="com.ducatus.SubscriptionsViewPagerFragment"
        android:label="fragment_subscriptions_view_pager"
        tools:layout="@layout/fragment_subscriptions_view_pager" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ducatus.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_transactionsFragment"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loansFragment"
            app:destination="@id/loansFragment" />
        <action
            android:id="@+id/action_homeFragment_to_subscriptionsViewPagerFragment"
            app:destination="@id/subscriptionsViewPagerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_budgetsFragment"
            app:destination="@id/budgetsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_reportsFragment"
            app:destination="@id/reportsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_goalsFragment"
            app:destination="@id/goalsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_challengesFragment"
            app:destination="@id/challengesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_tipsFragment"
            app:destination="@id/tipsFragment" />
    </fragment>
    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.ducatus.ReportsFragment"
        android:label="fragment_reports"
        tools:layout="@layout/fragment_reports" />
    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.ducatus.GoalsFragment"
        android:label="fragment_goals"
        tools:layout="@layout/fragment_goals" />
    <fragment
        android:id="@+id/challengesFragment"
        android:name="com.ducatus.ChallengesFragment"
        android:label="fragment_challenges"
        tools:layout="@layout/fragment_challenges" />
    <fragment
        android:id="@+id/tipsFragment"
        android:name="com.ducatus.TipsFragment"
        android:label="fragment_tips"
        tools:layout="@layout/fragment_tips" />

</navigation>