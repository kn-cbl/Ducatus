<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/budget"
    app:startDestination="@id/budgetDetailFragment">

    <fragment
        android:id="@+id/budgetDetailFragment"
        android:name="com.ducatus.BudgetDetailFragment"
        android:label="fragment_budget_detail"
        tools:layout="@layout/fragment_budget_detail">
        <action
            android:id="@+id/action_budgetDetailFragment_to_budgetEditDialogFragment"
            app:destination="@id/budgetEditDialogFragment" />
    </fragment>
    <dialog
        android:id="@+id/budgetEditDialogFragment"
        android:name="com.ducatus.BudgetEditDialogFragment"
        android:label="fragment_budget_edit"
        tools:layout="@layout/fragment_budget_edit_dialog">
        <argument
            android:name="budgetId"
            app:argType="string" />
        <argument
            android:name="budgetName"
            app:argType="string" />
        <argument
            android:name="budgetAmount"
            app:argType="string" />
        <argument
            android:name="budgetSpent"
            app:argType="string" />
        <argument
            android:name="categoryName"
            app:argType="string" />
    </dialog>
</navigation>