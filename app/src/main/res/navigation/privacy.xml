<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/privacy"
    app:startDestination="@id/privacyFragment">

    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.ducatus.PrivacyFragment"
        android:label="fragment_privacy"
        tools:layout="@layout/fragment_privacy" >
        <action
            android:id="@+id/action_privacyFragment_to_deleteUserDataDialogFragment"
            app:destination="@id/deleteUserDataDialogFragment" />
        <action
            android:id="@+id/action_privacyFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />
        <action
            android:id="@+id/action_privacyFragment_to_termsOfServiceFragment"
            app:destination="@id/termsOfServiceFragment" />
    </fragment>
    <dialog
        android:id="@+id/deleteUserDataDialogFragment"
        android:name="com.ducatus.DeleteUserDataDialogFragment"
        android:label="fragment_delete_user_data_dialog"
        tools:layout="@layout/fragment_delete_user_data_dialog" >
        <argument android:name="id"
            app:argType="string" />
    </dialog>
    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.ducatus.PrivacyPolicyFragment"
        android:label="fragment_privacy_policy"
        tools:layout="@layout/fragment_privacy_policy" />
    <fragment
        android:id="@+id/termsOfServiceFragment"
        android:name="com.ducatus.TermsOfServiceFragment"
        android:label="fragment_terms_of_service"
        tools:layout="@layout/fragment_terms_of_service" />
</navigation>